# ============================================================================
# BPM Platform — biến môi trường GO-LIVE. Copy file này thành .env và điền giá trị.
#   cp .env.example .env   &&   chỉnh sửa .env
# TUYỆT ĐỐI KHÔNG commit .env vào git. Mọi mật khẩu dưới đây là VÍ DỤ — hãy đổi.
# ============================================================================

# ---------------------------------------------------------------------------
# CSDL MariaDB
# ---------------------------------------------------------------------------
# Tên database (khớp giữa container mariadb và chuỗi kết nối backend).
MYSQL_DATABASE=bpm

# Mật khẩu root MariaDB (chỉ dùng quản trị DB; KHÔNG để mặc định khi go-live).
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_strong_password

# Tài khoản ứng dụng dùng để kết nối DB.
BPM_DB_USER=bpm
BPM_DB_PASSWORD=CHANGE_ME_app_db_password

# Chuỗi JDBC backend → service 'mariadb' trong mạng compose (giữ nguyên trừ khi đổi tên DB).
BPM_DB_URL=jdbc:mariadb://mariadb:3306/bpm

# ---------------------------------------------------------------------------
# Schema / Hibernate
# ---------------------------------------------------------------------------
# Lần go-live ĐẦU TIÊN: 'update' để Hibernate tạo bảng từ entity.
# Sau khi schema ổn định (đã backup), đổi sang 'validate' rồi 'docker compose up -d backend'.
BPM_DDL_AUTO=update

# Flowable (engine BPM) quản lý bảng ACT_* bằng cơ chế RIÊNG, độc lập BPM_DDL_AUTO.
# Lần go-live ĐẦU TIÊN: 'true' để Flowable tạo bảng ACT_*.
# Sau khi schema ổn định, đổi sang 'false' rồi 'docker compose up -d backend'.
BPM_FLOWABLE_SCHEMA_UPDATE=true

# ---------------------------------------------------------------------------
# Tài khoản & mật khẩu khởi tạo
# ---------------------------------------------------------------------------
# Mật khẩu tài khoản 'admin' tạo lần đầu (AdminSeeder). ĐỔI ngay sau lần đăng nhập đầu.
BPM_ADMIN_PASSWORD=CHANGE_ME_admin_password

# Mật khẩu mặc định khi tạo tài khoản nhân sự (import/HR). Người dùng đổi sau khi nhận.
BPM_HR_DEFAULT_PASSWORD=CHANGE_ME_hr_default_password

# ---------------------------------------------------------------------------
# Seed dữ liệu demo: PHẢI false ở môi trường thật (chỉ giữ tài khoản admin).
# (Profile 'prod' vốn không seed demo; đặt rõ false cho chắc.)
# ---------------------------------------------------------------------------
BPM_SEED_DEMO=false

# ---------------------------------------------------------------------------
# Cổng public của frontend (nginx). Mặc định 80. Nếu đặt reverse proxy HTTPS
# (Caddy/Cloudflare/nginx-proxy) phía trước, có thể đổi sang 8080 và để proxy nghe 443.
# ---------------------------------------------------------------------------
FRONTEND_PORT=80

# ---------------------------------------------------------------------------
# OnlyOffice JWT — KHÔNG dùng trong bản go-live này, nhưng đặt secret bất kỳ
# để backend không kế thừa secret dev mặc định. (Để nguyên nếu không bật OnlyOffice.)
# ---------------------------------------------------------------------------
BPM_ONLYOFFICE_JWT_SECRET=CHANGE_ME_unused_secret

# ---------------------------------------------------------------------------
# JVM (tùy chọn). Điều chỉnh theo RAM server.
# ---------------------------------------------------------------------------
JAVA_OPTS=-Xmx768m
